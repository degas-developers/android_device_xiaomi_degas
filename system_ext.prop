# Audio
ro.audio.flinger_standbytime_ms=2000
ro.audio.usb.period_us=16000

# Radio
ro.fota.oem=Xiaomi
ro.mi.os.soc.vendor=mtk
ro.vendor.mtk_cta_set=1
ro.vendor.mtk_gwsd_support=1
ro.vendor.mtk_telephony_add_on_policy=0
ro.vendor.vodata_support=1
vendor.rild.libargs=-d /dev/ttyC0
vendor.rild.libpath=mtk-ril.so

# Logging
# citsensorservice and the composer's CWB path log every ambient-light sample
# (~220 lines/s, over half of all logcat traffic on this device) and they use
# the E level for routine output, so a level filter is not enough. Silencing
# them cuts the daemon's CPU roughly in half while the screen is off.
# Re-enable any of them at runtime with `setprop log.tag.<tag> V`.
log.tag.HfManager=S
log.tag.libsensor-displayInfoManager=S
log.tag.libsensor-displayalgo=S
log.tag.libsensor-frameBufferManager=S
log.tag.libsensor-parseRGB=S
log.tag.libsensor-ssccalapi=S
log.tag.libcomposer_ext=W

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true

# Verison
ro.mi.os.version.code=3
ro.mi.os.version.incremental=OS3.0.4.0.WNEMIXM
ro.miui.build.region=global
ro.product.marketname=Xiaomi 14T
