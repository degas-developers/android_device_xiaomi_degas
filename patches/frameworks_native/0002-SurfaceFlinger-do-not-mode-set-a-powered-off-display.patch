@@ -1678,6 +1678,21 @@ void SurfaceFlinger::initiateDisplayModeChanges() {
 
         auto desiredMode = std::move(*desiredModeOpt);
 
+        // Do not drive a mode set into a powered-off panel. It cannot be completed
+        // there, and on MediaTek the composer answers such a request by emitting
+        // vsync callbacks for the requested timeline forever - measured at ~143/s
+        // with the screen off, which pins SurfaceFlinger at 18% of a core until the
+        // display is powered on again. Drop the request instead; the mode is
+        // re-evaluated from policy when the display comes back on.
+        if (display && !display->isPoweredOn()) {
+            if (FlagManager::getInstance().modeset_state_machine()) {
+                dropModeRequest(std::move(desiredMode));
+            } else {
+                dropModeRequest(displayId);
+            }
+            continue;
+        }
+
         const auto desiredModeId = desiredMode.mode.modePtr->getId();
         const auto displayModePtrOpt = physical.snapshot().displayModes().get(desiredModeId);
 
