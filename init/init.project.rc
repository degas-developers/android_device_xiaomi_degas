on post-fs-data
    # Xiaomi's collision telemetry (sensor-dfx-m18-collision) appends one record
    # per detected drop to this file, and citsensorservice parses the whole thing
    # into memory when it starts. On a tester's phone the writer was emitting
    # EMPTY lines instead of records until the file reached 27713536 bytes --
    # 27.7 million newlines and not one printable character -- at which point the
    # service's mCollision thread burned 100% of a core forever: 17.7 hours of CPU
    # in a single boot, SoC at 90 C. Emptying the file dropped it to 0.0% and the
    # SoC to 50 C within seconds. Verified on hardware 2026-08-02.
    #
    # Nothing on LineageOS reads these records -- they exist for Xiaomi's warranty
    # diagnostics -- so truncating them every boot costs nothing and bounds the
    # damage to one boot's worth of growth.
    #
    # This has to ship rather than be a support instruction: /mnt/vendor/persist
    # survives both reflashing and a factory reset, so an affected phone can never
    # recover on its own.
    #
    # persist.vendor.debug.collision.dfx=false does NOT help -- tested, the thread
    # spins with the feature off just the same.
    write /mnt/vendor/persist/sensors/collisionData.txt ""

    # The boot control HAL needs to open /dev/ufs-bsg0 to switch the active slot,
    # and it runs as root while the node comes up system:system 0660 -- see the
    # rule in ueventd.xiaomi.rc for the full story. That rule is correct (a manual
    # `echo add > /sys/class/bsg/ufs-bsg0/uevent` does flip the owner to root) but
    # it does not fire at boot: the node already exists by the time ueventd applies
    # our rules, and it does not re-own devices it did not create. So set it here
    # as well. The HAL only touches the node during an update, long after this.
    chown root system /dev/ufs-bsg0
    chmod 0660 /dev/ufs-bsg0

    # NFC
    mkdir /data/vendor/nfc 0770 nfc nfc
    chmod 0660 /dev/nq-nci
    chown nfc nfc /dev/nq-nci
    chmod 0660 /dev/p73
    chown nfc nfc /dev/p73

    # smart pa
    mkdir /mnt/vendor/persist/factory/ 0755 system system
    mkdir /mnt/vendor/persist/factory/audio 0755 system system
    mkdir /data/vendor/cit/ 0755 system system
    chown system system /sys/class/smartpa/re25_calib
    chmod 0666 /sys/class/smartpa/re25_calib

    # Thermal
    mkdir /data/vendor/thermal 0771 root system
    mkdir /data/vendor/thermal/config 0771 root system
    chown system system /sys/class/thermal/thermal_message/sconfig
    chown system system /sys/class/thermal/thermal_message/market_download_limit
    chown system system /sys/class/thermal/thermal_message/boost
    chown system system /sys/class/thermal/thermal_message/temp_state
    chown system system /sys/class/thermal/thermal_message/thermal_max_brightness
    chown cameraserver cameraserver /sys/class/thermal/thermal_message/flash_state
    chown system system /sys/class/thermal/thermal_message/balance_mode
    chown system system /sys/class/thermal/thermal_message/connsys_limit
    chown system system /sys/class/thermal/power_save/powersave_mode
    chown system system /sys/class/thermal/power_save/power_level
    chown system system /sys/class/mi_display/disp-DSI-0/thermal_hbm_disabled
    chmod 0664 /sys/class/mi_display/disp-DSI-0/thermal_hbm_disabled
    chown system system /sys/class/thermal/thermal_message/charger_temp
    chown system system /sys/class/power_supply/battery/constant_charge_current
    chmod 0664 /sys/class/power_supply/battery/constant_charge_current

# smart pa start
on property:vendor.audio.cit.spkcal.copy=true
    chmod 644 /data/vendor/cit/aw_cali.bin
    copy /data/vendor/cit/aw_cali.bin /mnt/vendor/persist/factory/audio/aw_cali.bin
    chmod 666 /mnt/vendor/persist/factory/audio/aw_cali.bin
    chmod 666 /data/vendor/cit/aw_cali.bin

on boot
    # Display feature sysfs node
    chown system system /sys/class/mi_display/disp-DSI-0/disp_param
    chmod 0664 /sys/class/mi_display/disp-DSI-0/disp_param
    chown system system /sys/class/mi_display/disp-DSI-0/mipi_rw
    chmod 0664 /sys/class/mi_display/disp-DSI-0/mipi_rw
    chown system system /sys/class/mi_display/disp-DSI-0/panel_info
    chmod 0444 /sys/class/mi_display/disp-DSI-0/panel_info
    chown system system /sys/class/mi_display/disp-DSI-0/wp_info
    chmod 0444 /sys/class/mi_display/disp-DSI-0/wp_info
    chown system system /sys/class/mi_display/disp-DSI-0/dynamic_fps
    chmod 0444 /sys/class/mi_display/disp-DSI-0/dynamic_fps
    chown system system /sys/class/mi_display/disp-DSI-0/doze_brightness
    chmod 0664 /sys/class/mi_display/disp-DSI-0/doze_brightness
    chown system system /sys/class/mi_display/disp-DSI-0/disp_count
    chmod 0664 /sys/class/mi_display/disp-DSI-0/disp_count
    chown system system /sys/class/mi_display/disp-DSI-0/brightness_clone
    chmod 0664 /sys/class/mi_display/disp-DSI-0/brightness_clone
    chown system system /sys/class/mi_display/disp-DSI-0/factory_max_brightness
    chmod 0444 /sys/class/mi_display/disp-DSI-0/factory_max_brightness

    # camera flash led
    chown system system /sys/class/flashlight_core/flashlight/torchbrightness
    chmod 0664 /sys/class/flashlight_core/flashlight/torchbrightness

# charger
on boot && property:ro.product.device=degas && property:ro.boot.hwc=GL
    setprop persist.vendor.accelerate.charge false

# Thermal scenario for mi_thermald.
#
# Xiaomi's thermal daemon picks its throttling policy from the scenario in
# thermal_message/sconfig, which HyperOS feeds from PowerKeeper. Nothing does
# that here, so sconfig stays at -1 forever and the daemon sits in its most
# conservative baseline policy: it clamps the CPU freq_qos from a *board*
# temperature of 33 C and settles at 1.4/2.3/2.4 GHz against hardware maxima of
# 2.2/3.2/3.35, while the die is only at 81 C. That costs a third of the CPU
# benchmark score. Every policy-backed scenario throttles just as hard; 6 is the
# one that leaves the CPU alone. The die then plateaus at 86-88 C under a
# sustained all-core load, against a 119 C crit trip.
#
# Two things about the trigger, both learned the hard way:
#
# It cannot be `on property:init.svc.mi_thermald=running`. This file is in
# /vendor, so *vendor_init* executes it, and vendor_init may not read
# init.svc.* (init_service_status_private_prop is core-only). The trigger then
# silently never fires; the only trace is one avc denial in dmesg.
#
# It cannot be `on boot` either. mi_thermald only reacts to the inotify event
# for a *change* of sconfig, and at `on boot` it has not established its watch
# yet - the file ends up reading 6 while the daemon still runs the baseline
# policy, which looks exactly like the fix working but does not. By
# sys.boot_completed the daemon is long up, and this is the only writer, so the
# -1 -> 6 transition is a real event it sees.
on property:sys.boot_completed=1
    write /sys/class/thermal/thermal_message/sconfig 6
