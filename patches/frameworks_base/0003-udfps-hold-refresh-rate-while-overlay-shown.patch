             mKeyguardViewManager.hideAlternateBouncer(true);
             Log.v(TAG, "hideUdfpsOverlay | removing window: " + removed);
         } else {
@@ -1115,7 +1129,7 @@ public class UdfpsController implements DozeReceiver, Dumpable {
 
         final View view = mOverlay.getTouchOverlay();
         if (isOptical() && view instanceof UdfpsTouchOverlay udfpsView) {
-            if (mIgnoreRefreshRate) {
+            if (mIgnoreRefreshRate || mHoldRefreshRateWhileShown) {
                 dispatchOnUiReady(requestId);
             } else {
                 udfpsView.configureDisplay(() -> dispatchOnUiReady(requestId));
diff --git a/services/core/java/com/android/server/display/mode/DisplayModeDirector.java b/services/core/java/com/android/server/display/mode/DisplayModeDirector.java
index b14448356..19be4cacc 100644
--- a/services/core/java/com/android/server/display/mode/DisplayModeDirector.java
+++ b/services/core/java/com/android/server/display/mode/DisplayModeDirector.java
@@ -2810,14 +2810,35 @@ public class DisplayModeDirector {
         private void updateVoteLocked(int displayId, boolean enabled, int votePriority) {
             final Vote vote;
             if (enabled) {
-                float maxRefreshRate = DisplayModeDirector.this.getMaxRefreshRateLocked(displayId);
-                vote = Vote.forPhysicalRefreshRates(maxRefreshRate, maxRefreshRate);
+                float refreshRate = votePriority == Vote.PRIORITY_UDFPS
+                        ? getUdfpsRefreshRateLocked(displayId)
+                        : DisplayModeDirector.this.getMaxRefreshRateLocked(displayId);
+                vote = Vote.forPhysicalRefreshRates(refreshRate, refreshRate);
             } else {
                 vote = null;
             }
             mVotesStorage.updateVote(displayId, votePriority, vote);
         }
 
+        /**
+         * config_udfpsRefreshRate when the display supports it, otherwise the highest refresh
+         * rate, which is what this vote has always asked for.
+         */
+        @GuardedBy("mLock")
+        private float getUdfpsRefreshRateLocked(int displayId) {
+            final int configured = mContext.getResources()
+                    .getInteger(R.integer.config_udfpsRefreshRate);
+            final Display.Mode[] modes = mSupportedModesByDisplay.get(displayId);
+            if (configured > 0 && modes != null) {
+                for (Display.Mode mode : modes) {
+                    if (Math.abs(mode.getRefreshRate() - configured) < 1f) {
+                        return mode.getRefreshRate();
+                    }
+                }
+            }
+            return DisplayModeDirector.this.getMaxRefreshRateLocked(displayId);
+        }
+
         @GuardedBy("mLock")
         void dumpLocked(PrintWriter pw) {
             pw.println("  UdfpsObserver");
