# Xiaomi touchfeature HAL (THP daemon host). Every rule below comes from a
# denial observed on the device while permissive, not from guesswork.
type hal_touchfeature_xiaomi_default, domain;
type hal_touchfeature_xiaomi_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_touchfeature_xiaomi_default)

# It publishes vendor.xiaomi.hw.touchfeature.ITouchFeature over binder and is
# called back by system_server and by XiaomiParts (see system_app.te).
binder_use(hal_touchfeature_xiaomi_default)
add_service(hal_touchfeature_xiaomi_default, vendor_hal_touchfeature_service)
binder_call(hal_touchfeature_xiaomi_default, system_server)
allow system_server hal_touchfeature_xiaomi_default:binder { call transfer };

# ...and separately reaches the framework sensor manager over hwbinder.
hwbinder_use(hal_touchfeature_xiaomi_default)
allow hal_touchfeature_xiaomi_default fwk_sensor_hwservice:hwservice_manager find;

get_prop(hal_touchfeature_xiaomi_default, hwservicemanager_prop)

# The daemon raises its own priority for the touch-frame thread.
allow hal_touchfeature_xiaomi_default self:capability sys_nice;

# The touch IC itself: the xiaomi-touch chardev, the raw input device it also
# reads events from, and the panel's sysfs knobs.
allow hal_touchfeature_xiaomi_default touchfeature_device:chr_file { rw_file_perms map };
allow hal_touchfeature_xiaomi_default input_device:dir r_dir_perms;
allow hal_touchfeature_xiaomi_default input_device:chr_file rw_file_perms;
rw_dir_file(hal_touchfeature_xiaomi_default, sysfs_touch)
allow hal_touchfeature_xiaomi_default proc_touch:file { open write };

# It watches the thermal power-save state to back the sampling rate off.
r_dir_file(hal_touchfeature_xiaomi_default, sysfs_therm)
allow hal_touchfeature_xiaomi_default sysfs_therm:file watch;

# /odm/etc/init.panel_info.sh, run through /vendor/bin/sh by init: it reads the
# panel identity out of the touch node and republishes it as vendor properties.
type vendor_touch_init_shell, domain;
type vendor_touch_init_shell_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_touch_init_shell)

allow vendor_touch_init_shell vendor_shell_exec:file entrypoint;
allow vendor_touch_init_shell vendor_toolbox_exec:file execute_no_trans;
r_dir_file(vendor_touch_init_shell, sysfs_touch)
set_prop(vendor_touch_init_shell, vendor_panel_prop)
