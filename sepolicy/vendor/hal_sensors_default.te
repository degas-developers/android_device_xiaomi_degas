hal_client_domain(hal_sensors_default, hal_audio)
hal_client_domain(hal_sensors_default, hal_graphics_allocator)
hal_client_domain(hal_sensors_default, hal_mtk_composer_ext)

binder_call(hal_sensors_default, hal_graphics_composer_default)

create_dir_file(hal_sensors_default, persist_data_file)
r_dir_file(hal_sensors_default, sysfs_leds)
r_dir_file(hal_sensors_default, vendor_sysfs_displayfeature)

# Allow access to raw HID devices for dynamic sensors.
allow hal_sensors_default device:dir r_dir_perms;
allow hal_sensors_default hidraw_device:chr_file rw_file_perms;

# sensors.udfps.degas reads the goodix touch controller's FOD press key straight
# from the input device: no hardware sensor reports a fingerprint press here, so
# this is what feeds config_dozeUdfpsLongPressSensorType. The process is already
# in the input group, so only the label needs allowing.
allow hal_sensors_default input_device:dir r_dir_perms;
allow hal_sensors_default input_device:chr_file r_file_perms;

allow hal_sensors_default audio_socket:sock_file rw_file_perms;
allow hal_sensors_default dmabuf_system_secure_heap_device:chr_file r_file_perms;
allow hal_sensors_default fwk_sensor_hwservice:hwservice_manager find;
allow hal_sensors_default hal_graphics_allocator_default_tmpfs:file rw_file_perms;
allow hal_sensors_default sensors_device:chr_file rw_file_perms;
allow hal_sensors_default vendor_displayfeature_device:chr_file r_file_perms;

get_prop(hal_sensors_default, vendor_displayfeature_prop)
# Allow access for dynamic sensor properties.
get_prop(hal_sensors_default, vendor_dynamic_sensor_prop)

# The udfps sub-HAL also toggles the touch controller's palm rejection while
# dozing, and publishes its state as a vendor property.
rw_dir_file(hal_sensors_default, sysfs_touch)
set_prop(hal_sensors_default, vendor_mtk_sensor_prop)
